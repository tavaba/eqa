<?xml version="1.0" encoding="utf-8" ?>
<form>
    <fields name="filter" addfieldprefix="Kma\Component\Eqa\Administrator\Field">
        <field
                name="search"
                type="text"
                label="JSEARCH_FILTER"
                hint="JSEARCH_FILTER"
                class="js-stools-search-string"
        />
        <field
                name="campus_id"
                type="campus"
                label="Cơ sở đào tạo"
                default=""
                onchange="this.form.submit();"
        />
        <field
                name="unit_id"
                type="unit"
                label="COM_EQA_FORM_EMPOYEES_FILTER_UNIT_LABEL"
                default=""
                class="select2-basic"
                onchange="this.form.submit();"
        >
            <option value="">COM_EQA_FORM_EMPOYEES_FILTER_UNIT_MSG</option>
        </field>
        <field  addfieldprefix="Kma\Library\Kma\Field"
                name="state"
                type="state"
                mode="filter"
                label="Trạng thái"
                default=""
                onchange="this.form.submit();"
        />
    </fields>
    <fields name="list">
        <field
                name="fullordering"
                type="hidden"
                value=""
        />
        <field
                name="limit"
                type="limitbox"
                label="JGLOBAL_LIST_LIMIT"
                onchange="this.form.submit();" />

    </fields>

</form>