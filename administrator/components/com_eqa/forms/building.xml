<?xml version="1.0" encoding="utf-8" ?>
<form>
    <fieldset name="building" addfieldprefix="Kma\Component\Eqa\Administrator\Field">
        <field
                name="id"
                type="hidden"
            />
        <field
                name="campus_id"
                type="campus"
                required="true"
                label="Cơ sở đào tạo"
                description="Tòa nhà thuộc cơ sở đào tạo nào. Người dùng thường không đổi được giá trị này."
                readonly="true"
        />
        <field
                name="code"
                type="text"
                label="COM_EQA_FORM_BUILDING_CODE_LABEL"
                required="true"
                pattern="[A-Z0-9]{2,10}"
        />
        <field
                name="description"
                type="textarea"
                label="COM_EQA_GENERAL_DESC"
        />
        <field
                name="created_by"
                type="user"
                label="JGLOBAL_FIELD_CREATED_BY_LABEL"
                readonly="true"
        />
        <field
                name="created_at"
                type="calendar"
                format="%Y-%m-%d %H:%M:%S"
                filter="user_utc"
                readonly="true"
                label="JGLOBAL_FIELD_CREATED_LABEL"
        />
        <field
                name="modified_by"
                type="user"
                label="JGLOBAL_FIELD_MODIFIED_BY_LABEL"
                readonly="true"
        />
        <field
                name="modified_at"
                type="calendar"
                format="%Y-%m-%d %H:%M:%S"
                filter="user_utc"
                readonly="true"
                label="JGLOBAL_FIELD_MODIFIED_LABEL"
        />
    </fieldset>
</form>