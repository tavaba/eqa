<?xml version="1.0" encoding="utf-8" ?>
<form>
    <fields name="filter" addfieldprefix="Kma\Component\Eqa\Administrator\Field">
        <field
                name="search"
                type="text"
                label="JSEARCH_FILTER"
                hint="JSEARCH_FILTER"
                class="js-stools-search-string"
        />
        <field
                name="academicyear"
                type="academicyear"
                label="Năm học"
                default=""
                onchange="this.form.submit();"
        >
            <option value="">-Năm học-</option>
        </field>
        <field
                name="term"
                type="term"
                label="Học kỳ"
                default=""
                onchange="this.form.submit();"
        >
            <option value="">-Học kỳ-</option>
        </field>
        <field
                name="subject_id"
                type="subject"
                label="Môn học"
                default=""
                class="select2-basic"
                onchange="this.form.submit();"
        >
            <option value="">-Môn học-</option>
        </field>
    </fields>
    <fields name="list">
        <field
                name="limit"
                type="limitbox"
                label="JGLOBAL_LIST_LIMIT"
                onchange="this.form.submit();" />
    </fields>
</form>
